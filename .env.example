# .env.example — research-assistant-crew
# Copy to .env and fill in values to activate live backends. Leave blank for mock mode.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  PROGRESSIVE CREDENTIAL LOADING (PCL)                                   │
# │  No keys needed to run. Add keys to unlock production-grade backends.   │
# └─────────────────────────────────────────────────────────────────────────┘

# ── AI Providers ─────────────────────────────────────────────────────────
# UNSET or dummy (default): Zero-credential deterministic mock research report (CI-safe)
# SET to OpenAI key (sk-...): Live CrewAI 3-agent research synthesis with GPT-4o-mini
OPENAI_API_KEY=

# ── Model & Server ────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini
PORT=8000
